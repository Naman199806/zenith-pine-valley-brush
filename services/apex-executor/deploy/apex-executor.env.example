# Copy to /etc/apex-executor/secrets.env on the VM.
# chmod 0600 and chown apex-executor. Do not commit filled values.
# Do not put LIVE brokerage keys in this file.

APEX_EXECUTOR_MODE=PAPER
APEX_EXECUTOR_PORT=8787
APEX_EXECUTOR_HEALTH_TOKEN=replace-with-a-local-token
APEX_EXECUTOR_DATA=/var/lib/apex-executor
APEX_EXECUTOR_STATE=/var/lib/apex-executor/state.json
APEX_EXECUTOR_LOCK=/var/lib/apex-executor/writer.lock
APEX_EXECUTOR_INBOX=/var/lib/apex-executor/inbox.jsonl
APEX_EXECUTOR_JOURNAL=/var/lib/apex-executor/journal.jsonl
APEX_EXECUTOR_HERMES=/var/lib/apex-executor/hermes.json
APEX_EXECUTOR_FILLS=/var/lib/apex-executor/fills.jsonl
APEX_EXECUTOR_PAPER_SECRETS_FILE=/etc/apex-executor/paper.json

# Paper credentials, isolated from the research process.
# APEX_EXECUTOR_PAPER_KEY_ID=replace-with-paper-key-id
# APEX_EXECUTOR_PAPER_SECRET=replace-with-paper-secret

# Operator and gate secrets verify signatures. They are not brokerage keys.
# APEX_OPERATOR_SECRET=replace-with-operator-secret
# APEX_GATE_SECRET=replace-with-gate-secret

# LIVE keys are intentionally absent.

# Delay between broker polls. Default 3000. A success resets backoff to this value.
# Failures double from it and cap at 30000.
APEX_EXECUTOR_POLL_INTERVAL_MS=3000

# Optional freshness window in milliseconds. Default 5000.
# Larger values are clamped to 5000 and cannot extend execution authority.
# APEX_EXECUTOR_STALE_AFTER_MS=5000
