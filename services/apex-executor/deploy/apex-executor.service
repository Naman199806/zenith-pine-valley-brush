[Unit]
Description=Apex Executor PAPER read-only
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/apex-quant-x
Environment=APEX_EXECUTOR_MODE=PAPER
EnvironmentFile=-/etc/apex-executor/secrets.env
ExecStart=/usr/bin/node --experimental-strip-types services/apex-executor/src/main.ts
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/apex-executor
Environment=APEX_EXECUTOR_STATE=/var/lib/apex-executor/state.json
Environment=APEX_EXECUTOR_LOCK=/var/lib/apex-executor/writer.lock
Environment=APEX_EXECUTOR_INBOX=/var/lib/apex-executor/inbox.jsonl

[Install]
WantedBy=multi-user.target
