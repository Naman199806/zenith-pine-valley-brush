<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Plotly.NET</id>
    <version>5.1.0</version>
    <authors>Timo Mühlhaus, Kevin Schneider, F# open source contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.png</icon>
    <projectUrl>https://plotly.net/</projectUrl>
    <description>plotly.js charts in .NET programming languages 📈🚀.</description>
    <tags>visualization charting plotly fsharp csharp</tags>
    <repository type="git" url="https://github.com/plotly/Plotly.NET/" commit="6cdf52dcf8f173d9f81f7a62140ac96d0b0072e9" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="DynamicObj" version="[2.0.0, 3.0.0)" exclude="Build,Analyzers" />
        <dependency id="FSharp.Core" version="8.0.400" exclude="Build,Analyzers" />
        <dependency id="Giraffe.ViewEngine.StrongName" version="2.0.0-alpha1" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>