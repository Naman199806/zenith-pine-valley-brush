<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Plotly.NET.Interactive</id>
    <version>5.0.0</version>
    <authors>Gregor Beyerle, Timo Mühlhaus, Kevin Schneider, F# open source contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.png</icon>
    <projectUrl>https://plotly.net/</projectUrl>
    <description>A .NET Interactive Kernel Extension for displaying Plotly.NET charts.</description>
    <releaseNotes>- bump version range of Plotly.NET to [5.0.0, 6.0.0)
- Update .NET interactive references</releaseNotes>
    <tags>visualization charting plotly fsharp csharp</tags>
    <repository type="git" url="https://github.com/plotly/Plotly.NET/" commit="cd63a51d6621a82ff9e3bdeeb63aa269a744da89" />
    <dependencies>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Plotly.NET" version="[5.0.0, 6.0.0)" exclude="Build,Analyzers" />
        <dependency id="FSharp.Core" version="8.0.300" exclude="Build,Analyzers" />
        <dependency id="Microsoft.DotNet.Interactive" version="1.0.0-beta.24229.4" exclude="Build,Analyzers" />
        <dependency id="Microsoft.DotNet.Interactive.Formatting" version="1.0.0-beta.24229.4" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>