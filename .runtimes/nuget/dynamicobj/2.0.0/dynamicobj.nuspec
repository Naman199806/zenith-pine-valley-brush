<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DynamicObj</id>
    <version>2.0.0</version>
    <authors>Timo Mühlhaus, Kevin Schneider, F# open source contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <projectUrl>https://csbiology.github.io/DynamicObj/</projectUrl>
    <description>F# library supporting Dynamic Objects including inheritance in functional style.</description>
    <releaseNotes>- [Use a strong name for the assembly](https://github.com/CSBiology/DynamicObj/pull/19). This may cause backwards incompatibility on netfx. (thanks [@WhiteBlackGoose](https://github.com/WhiteBlackGoose))</releaseNotes>
    <tags>F# FSharp dotnet dynamic object</tags>
    <repository type="git" url="https://github.com/CSBiology/DynamicObj" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="FSharp.Core" version="6.0.2" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>