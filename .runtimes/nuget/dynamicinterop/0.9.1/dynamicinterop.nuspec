<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>DynamicInterop</id>
    <version>0.9.1</version>
    <title>Make .NET P/Invoke a bit more dynamic</title>
    <authors>Jean-Michel Perraud, Daniel Collins, Kosei, evolvedmicrobe</authors>
    <owners>Jean-Michel Perraud, Daniel Collins, Kosei, evolvedmicrobe</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://github.com/jmp75/dynamic-interop-dll/blob/feature/netstandard2/License.txt</licenseUrl>
    <projectUrl>https://github.com/jmp75/dynamic-interop-dll</projectUrl>
    <description>Load native shared libraries from .NET on Unix, Windows or MacOS. This package offers more facilities to handle a native library at runtime rather than at compile time (vanilla P/Invoke uses rather static idioms).</description>
    <releaseNotes>Migration to .NET Standard 2.0</releaseNotes>
    <copyright>(c) 2014-2017 Jean-Michel Perraud; (c) 2014 Daniel Collins, CSIRO; (c) 2013 Kosei, evolvedmicrobe</copyright>
    <tags>interop dynamic p/invoke</tags>
    <repository url="https://github.com/jmp75/dynamic-interop-dll" />
    <dependencies>
      <group targetFramework=".NETStandard2.0" />
    </dependencies>
  </metadata>
</package>