<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Plotly.NET.CSharp</id>
    <version>0.13.0</version>
    <authors>Kevin Schneider, open source contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.png</icon>
    <projectUrl>https://plotly.net/</projectUrl>
    <description>Native C# bindings for Plotly.NET 📈🚀.</description>
    <releaseNotes>- [Add C# wrapper for Chart.SingleStack](https://github.com/plotly/Plotly.NET/pull/467) thanks [@TheKiiiing](https://github.com/TheKiiiing)!</releaseNotes>
    <tags>visualization charting plotly fsharp csharp</tags>
    <repository type="git" url="https://github.com/plotly/Plotly.NET/" commit="6cdf52dcf8f173d9f81f7a62140ac96d0b0072e9" />
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="Plotly.NET" version="[5.0.0, 6.0.0)" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>